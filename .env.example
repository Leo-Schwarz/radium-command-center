# Fireflies API key — get yours at https://app.fireflies.ai/settings
FIREFLIES_API_KEY=your_api_key_here

# HubSpot Private App access token — create at Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=your_access_token_here

# LinkedIn OAuth app credentials — https://developer.linkedin.com/
# Vite exposes only env vars prefixed with VITE_ to the browser
VITE_LINKEDIN_CLIENT_ID=your_client_id_here
VITE_LINKEDIN_CLIENT_SECRET=your_client_secret_here